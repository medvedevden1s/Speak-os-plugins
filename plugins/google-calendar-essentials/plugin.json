{
  "$schema": "../../schema/plugin.schema.json",
  "format": 1,
  "id": "google-calendar-essentials",
  "name": "Google Calendar Essentials",
  "version": "1.0.0",
  "description": "Hear your agenda, find free time, schedule a meeting and move an event, all by voice.",
  "apps": ["googlecalendar"],
  "actions": {
    "read": ["GOOGLECALENDAR_EVENTS_LIST", "GOOGLECALENDAR_FIND_EVENT", "GOOGLECALENDAR_FIND_FREE_SLOTS"],
    "write": ["GOOGLECALENDAR_CREATE_EVENT", "GOOGLECALENDAR_PATCH_EVENT"]
  },
  "author": { "name": "Speak OS", "github": "medvedevden1s" },
  "license": "MIT",
  "category": "calendar",
  "keywords": ["calendar", "meetings", "schedule"]
}
